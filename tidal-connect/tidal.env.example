# Tidal Connect runtime config — passed to the container via `docker run --env-file`
# (services/tidal-connect.service). The container's baked entrypoint reads these.
# See README.md in this directory for the deploy steps.

FRIENDLY_NAME=VibesboxSRC
MODEL_NAME=Vibesbox

# MQA: the Vibesbox DSP chain expects linear PCM, so leave MQA off (no passthrough,
# no MQA core decode advertised). Tidal sends FLAC/PCM which the bridge resamples to 96k.
MQA_PASSTHROUGH=false
MQA_CODEC=false

# ── PortAudio output device ──────────────────────────────────────────────────
# MUST point at the Tidal snd-aloop card (hw:Tidal == card 15) so audio reaches
# ardftsrc-bridge@tidal — NOT the HiFiBerry/default device. The exact PortAudio
# device NAME (with PA_ALSA_PLUGHW=1, baked into the image) is only knowable on the
# box. Discover it at deploy with:
#
#   docker exec tidal_connect /app/ifi-tidal-release/bin/ifi-pa-devs-get
#
# then set the matching "Tidal"/"hw:15,0" entry below and restart the service.
# Until it is set correctly, Tidal audio will NOT route into Vibesbox.
PLAYBACK_DEVICE=__SET_AT_DEPLOY__
