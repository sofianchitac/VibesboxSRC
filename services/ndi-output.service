[Unit]
Description=NDI Output — 8ch Audio Transmitter (NDI SDK via Python)
# Reads CamillaDSP's output straight out of PipeWire (the ALSA `pipewire` plugin), so the
# daemon must be up — not just the loopback cards, which this service no longer touches.
After=camilladsp.service pipewire.service wireplumber.service network-online.target avahi-daemon.service
Wants=network-online.target camilladsp.service pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=/opt/vibesbox-src/venv/bin/python3 /opt/vibesbox-src/scripts/ndi_transmitter.py
Restart=on-failure
RestartSec=5
User=root

# RT scheduling: the transmitter reads on a 512/96kHz (~5.3ms) cadence. At SCHED_OTHER it
# can be preempted by the kiosk (nice -8), starving the read and producing audible crackle
# on the LattePanda. FIFO 20 preempts ALL SCHED_OTHER (incl. the kiosk) while staying well
# below PipeWire's audio-graph RT threads (FIFO 83-88), so the DSP graph is never starved.
# LimitRTPRIO must be >= the priority for the policy to stick. (2026-06-30)
# ⌀ It does NOT gate the plugin's own client thread: `data-loop.0` runs at FIFO 83 inside
# this process regardless, granted by root's CAP_SYS_NICE (verified 2026-08-21).
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=20
LimitRTPRIO=21

# NDI source name as shown on the network.
# NDI_TX_NAME stays "VibesboxSRC-5.1" ON PURPOSE: the receiver finds the stream by that
# exact name, so renaming it would break discovery on the LattePanda. The name is
# historical (the stream has been 8ch since 2026-08-13), not a description of the width.
Environment=NDI_TX_NAME=VibesboxSRC-5.1

# libndi.so location — change only if you have installed the NDI SDK elsewhere.
Environment=NDI_LIB_PATH=/usr/local/lib/libndi.so

# PipeWire socket env for the ALSA `pipewire` plugin (system-mode PipeWire; must match
# pipewire.service / source-router.service / ardftsrc-bridge@.service).
Environment=XDG_RUNTIME_DIR=/run/pipewire
Environment=PIPEWIRE_REMOTE=pipewire-0

# Names the client node so source_router can find it, and keeps WirePlumber from linking it
# anywhere — source_router is the sole routing authority (with autoconnect=false the node
# appears with ZERO links, verified 2026-08-21).
Environment="PIPEWIRE_ALSA={ node.name=ndi-tx-in node.description=Vibesbox-NDI-transmitter node.autoconnect=false }"

# The capture device. ⌀ NODE= is deliberately EMPTY — "target nothing"; naming dsp-out here
# would author a second, unmanaged link on top of source_router's.
# ⚠ PERIOD_BYTES must equal NDI_PERIOD × NDI_ALSA_CH × 4 = 512 × 8 × 4 = 16384, and
# BUFFER_BYTES twice that. The plugin grants EXACTLY what is asked (measured 2026-08-21:
# 512/1024 frames), so a mismatch silently runs this reader off the 512 chain.
# ★ Replaced hw:NDITX,1,0 on 2026-08-21. Reading CamillaDSP's output back through the
# sink.ndi-feed -> snd-aloop -> ALSA path cost 18.5-20.0 ms end to end, measured over four
# interleaved block pairs at two rates (docs/ndi-loopback-hop-brief.md). The sink, its
# WirePlumber rules and the NDITX loopback card are all retired with it.
Environment=NDI_ALSA_DEV=pipewire:NODE=,PERIOD_BYTES=16384,BUFFER_BYTES=32768

# Must match CamillaDSP's output samplerate and chunksize.
# NDI_PERIOD 1024 -> 512 with the rest of the 512 chain (2026-06-10 latency phase 2).
# This env OVERRIDES the ndi_transmitter.py file default — edit here, not there.
# 8 channels since 2026-08-13 (was 6) — eARC LPCM surrounds ride lanes 7-8; see dsp_8ch.yml.
Environment=NDI_RATE=96000
Environment=NDI_ALSA_CH=8
Environment=NDI_PERIOD=512

[Install]
WantedBy=multi-user.target
