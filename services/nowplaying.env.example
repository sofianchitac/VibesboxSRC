# Environment file for metadata-orchestrator.service.
# Installed once to /etc/vibesbox/nowplaying.env — edit before enabling
# the Lyrion producer.

# ── Lyrion / LMS ──────────────────────────────────────────────────────
# Hostname or IP of the LMS server on the LAN.
# Leave blank to disable the Lyrion producer (Generic fallback will be used).
LMS_HOST=

# JSON-RPC port (LMS default).
LMS_PORT=9000

# squeezelite's identifier on LMS: MAC address (aa:bb:cc:dd:ee:ff) or
# the friendly player name shown in LMS's UI.
LMS_PLAYER_ID=

# Poll rate in Hz. Default 1.
LMS_POLL_HZ=1.0

# ── Now Playing server overrides (rarely needed) ──────────────────────
# AUTOROUTER_WS=ws://127.0.0.1:8080
# NOWPLAYING_URL=http://127.0.0.1:8090/api/nowplaying
