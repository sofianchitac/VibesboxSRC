[Unit]
# See cap-watch.service. Every 10 minutes: the collector re-reads a 2-minute overlap and
# dedupes, so a missed run costs nothing as long as the gap stays under the journal's own
# retention.
Description=Collect ardftsrc capture-ring depth samples every 10 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=10min
# Survives reboots: a run missed while the box was off happens shortly after it comes back.
Persistent=true

[Install]
WantedBy=timers.target
