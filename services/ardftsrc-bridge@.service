[Unit]
Description=ARDFTSRC Bridge — native Rust DFT resampler for %i
# v3: reads the raw ALSA device, emits a source.%i.ardftsrc PipeWire node (via the ALSA
# "pipewire" plugin output), so PipeWire + WirePlumber must be up alongside the loopback cards.
After=alsa-loopback.service pipewire.service wireplumber.service
Requires=alsa-loopback.service
Wants=pipewire.service wireplumber.service
# The @tv instance is stopped/started by source_router on every TV LPCM<->AC-3 format
# change (Stage 2). Disable systemd's start rate-limit so rapid switches (scrubbing a
# 5.1 movie) can't trip "start request repeated too quickly" and strand the source.
# Harmless for the other on-demand instances, which effectively never restart.
StartLimitIntervalSec=0

[Service]
Type=simple
# PipeWire socket env for the bridge's ALSA "pipewire" plugin output (system-mode PipeWire;
# must match pipewire.service / source-router.service — VALIDATE AT DEPLOY, Risk #8).
Environment=XDG_RUNTIME_DIR=/run/pipewire
Environment=PIPEWIRE_REMOTE=pipewire-0
ExecStart=/opt/vibesbox-src/bin/ardftsrc-bridge %i
# ── RT scheduling (2026-09-03) ──
# ⛔ Deliberately NOT CPUSchedulingPolicy=fifo. That would promote the WHOLE process, and this
# process's other thread runs the DFT — a long, bursty compute that must not preempt anything.
# The bridge promotes its CAPTURE thread only, from inside (set_capture_thread_fifo in
# src/main.rs), to FIFO 20: the same priority ndi-output uses and for the same reason — above
# every SCHED_OTHER process, far below PipeWire's audio-graph threads (FIFO 83-88), so the
# graph this feeds can never be starved by its own producer.
# Until this, the thread blocking in readi on an isochronous USB gadget / I2S slave ran
# SCHED_OTHER, competing on equal terms with the QML kiosk.
# LimitRTPRIO is belt-and-braces: as User=root the promotion already succeeds via CAP_SYS_NICE,
# but this keeps it working if the unit is ever moved off root. Set ARDFTSRC_CAP_RTPRIO=0 in a
# drop-in to A/B the old behaviour without rebuilding.
LimitRTPRIO=21
# Bridge-down = source-dead (the source can't reach dsp-in without it), so self-heal fast
# (spec §6). Keep SIGKILL (snd_pcm_readi can block uninterruptibly on isochronous hw reads).
Restart=on-failure
RestartSec=2
User=root
KillSignal=SIGKILL
# SIGKILL is the STOP signal (above), so an ordinary `systemctl stop` — which is how
# source_router retires an idle source — leaves the unit in `Result: signal` = failed.
# Without this line every clean stop shows up in `systemctl --failed`, and a health
# check that is always dirty hides the real failures it exists to surface. Counted 8
# such false entries for @tv and 5 for @lyrion before this was added (2026-08-13).
SuccessExitStatus=SIGKILL
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
